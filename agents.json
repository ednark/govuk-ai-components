{
  "name": "govuk-ai-components",
  "description": "GOV.UK Design System component registry for AI coding agents. Self-contained, accessible UK government components with full adaptation and coordination metadata.",
  "repo": "https://github.com/ednark/govuk-ai-components",
  "base": "https://raw.githubusercontent.com/ednark/govuk-ai-components/main",
  "count": 45,
  "facetsUrl": "https://raw.githubusercontent.com/ednark/govuk-ai-components/main/infinite/facets.json",
  "index": "https://raw.githubusercontent.com/ednark/govuk-ai-components/main/infinite/components.index.json",
  "indexSchemaVersion": 1,
  "metadataSchemaVersion": 2,
  "tileFetchPattern": "https://raw.githubusercontent.com/ednark/govuk-ai-components/main/infinite/{file}",
  "designSystem": {
    "name": "GOV.UK Design System",
    "version": "5.x"
  },
  "agentMetaId": "govuk-agent-meta",
  "tileDir": "infinite",
  "facets": [
    "gdsComponentType",
    "section",
    "variant",
    "requiresJs",
    "interaction",
    "a11y",
    "govCompliance",
    "costTier",
    "prerequisites",
    "compositionRecipes",
    "piiHandling",
    "touchTargetSize",
    "supportedTokenProfiles"
  ],
  "flow": [
    "GET agents.json",
    "GET facets.json",
    "GET components.index.json",
    "filter by facet in code",
    "GET tile by file",
    "read govuk-agent-meta block"
  ],
  "recipesUrl": "https://raw.githubusercontent.com/ednark/govuk-ai-components/main/infinite/recipes/index.json",
  "versionsUrl": "https://raw.githubusercontent.com/ednark/govuk-ai-components/main/infinite/versions.json",
  "compatibilityUrl": "https://raw.githubusercontent.com/ednark/govuk-ai-components/main/compatibility.json",
  "compatibilityTargets": [
    "uswds",
    "dsfr",
    "ecl"
  ],
  "mcp": {
    "enabled": true,
    "server": "_base/mcp/server.mjs",
    "transport": "stdio",
    "tools": [
      "search_components",
      "get_component",
      "list_facets",
      "get_index",
      "get_adapter",
      "translate_component",
      "get_recipe",
      "query_compliance",
      "get_versions"
    ]
  },
  "compatibilityPath": "compatibility.json",
  "updated": "0.2.0",
  "language": "en",
  "contentLanguages": [
    "en",
    "cy (footer link)"
  ]
}